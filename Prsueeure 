function updateTotal()
	local count = 0
	local repeatNum = tonumber(repeatBox.Text) or 0
	for _, isOn in pairs(selected) do
		if isOn then count += 1 end
	end
	totalLabel.Text = string.format("预计总修改器数量: %d", count * repeatNum)
end

repeatBox:GetPropertyChangedSignal("Text"):Connect(updateTotal)
updateTotal()

createBtn.MouseButton1Click:Connect(function()
	local repeatNum = tonumber(repeatBox.Text)
	if not repeatNum or repeatNum < 1 then
		statusLabel.Text = "请输入有效的重复次数"
		statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	local selectedList = {}
	for name, isOn in pairs(selected) do
		if isOn then
			table.insert(selectedList, name)
		end
	end

	if #selectedList == 0 then
		statusLabel.Text = "请至少勾选一个修改器"
		statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	local finalModifiers = {}
	for i = 1, repeatNum do
		for _, modName in ipairs(selectedList) do
			table.insert(finalModifiers, modName)
		end
	end

	statusLabel.Text = "正在发送大量修改器请求..."
	statusLabel.TextColor3 = Color3.fromRGB(255, 200, 80)

	local events = ReplicatedStorage:FindFirstChild("Events")
	if not events then
		statusLabel.Text = "找不到 Events"
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		return
	end

	local createLobbyEvent = events:FindFirstChild("CreateLobby")
	if not createLobbyEvent then
		statusLabel.Text = "找不到 CreateLobby"
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		return
	end

	local args = {
		{
			LobbyAccess = LOBBY_ACCESS,
			LobbySize = LOBBY_SIZE,
			Gamemode = "Modifiers",
			Modifiers = finalModifiers,
		}
	}

	local success, result = pcall(function()
		return createLobbyEvent:InvokeServer(unpack(args))
	end)

	if success then
		statusLabel.Text = string.format("已发送！总修改器: %d", #finalModifiers)
		statusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
		print("[刷钱UI] 成功发送，总数量:", #finalModifiers)
	else
		statusLabel.Text = "发送失败: " .. tostring(result)
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		warn("[刷钱UI] 失败:", result)
	end
end)

-- 拖动
local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

