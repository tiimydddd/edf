local function autoFarmFlow()
    Notify("★ Auto Farm 启动...")
    getKey()
    getFirstAid()
    task.wait(0.4)

    local store, part = nil, nil
    for obj in pairs(knownStores) do
        if obj and obj.Parent then
            part = bestPart(obj)
            if part then break end
        end
    end
    if not part then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isStore(obj) then
                knownStores[obj] = true
                part = bestPart(obj)
                if part then break end
            end
        end
    end
    if part then
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = part.CFrame + Vector3.new(0, 4, 0)
            task.wait(0.25)
            for _, obj in ipairs(workspace:GetDescendants()) do
                if isCard(obj) then
                    tryInteract(obj, hrp)
                    gotCard = true
                end
            end
        end
    end

    task.wait(0.3)
    goToShelter()
    Notify("Auto Farm 完成")
end

local function findCardStore()
    cleanCache(knownStores)
    for obj in pairs(knownStores) do
        if obj and obj.Parent then
            local part = bestPart(obj)
            if part then return obj, part end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isStore(obj) then
            knownStores[obj] = true
            local part = bestPart(obj)
            if part then return obj, part end
        end
    end
    return nil, nil
end

local function clickCardInStore()
    local hrp = getHRP()
    if not hrp then return false end
    local store, storePart = findCardStore()
    if storePart then
        hrp.CFrame = storePart.CFrame + Vector3.new(0, 4, 0)
        task.wait(0.2)
    end
    local got = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCard(obj) then
            knownCards[obj] = true
            if tryInteract(obj, hrp) then
                got = true
                gotCard = true
            end
        end
    end
    return got
end

local function tpCardStore()
    local hrp = getHRP()
    if not hrp then return false end
    local store, part = findCardStore()
    if part then
        hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
