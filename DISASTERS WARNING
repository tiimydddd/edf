local function tpNearestChest()
    local hrp = getHRP()
    if not hrp then Notify("没有角色") return end
    cleanCache(knownChests)
    local best, bestDist = nil, math.huge
    local function consider(obj)
        local part = bestPart(obj)
        if not part then return end
        local d = (part.Position - hrp.Position).Magnitude
        if d < bestDist then bestDist = d best = obj end
    end
    for obj in pairs(knownChests) do
        if obj and obj.Parent then consider(obj) end
    end
    if not best then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isChest(obj) then knownChests[obj] = true consider(obj) end
        end
    end
    if best then
        tryInteract(best, hrp)
        Notify(string.format("最近宝箱 (%.0f)", bestDist))
    else
        Notify("没有宝箱")
    end
end

local function forceTPShelter()
    local hrp = getHRP()
    if not hrp then Notify("没有角色") return end
    local candidates = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelter(obj) then
            local part = bestPart(obj)
            if part then table.insert(candidates, part) end
        end
    end
    if #candidates == 0 then Notify("没找到避难所") return end
    local offsets = {
        Vector3.new(0, 4, 0), Vector3.new(0, 3, 6), Vector3.new(0, 3, -6),
        Vector3.new(6, 3, 0), Vector3.new(-6, 3, 0), Vector3.new(0, 6, 0),
    }
    Notify("强制 TP 进避难所...")
    for _, part in ipairs(candidates) do
        for _, offset in ipairs(offsets) do
            hrp.CFrame = part.CFrame + offset
            task.wait(0.06)
            local prompt = part:FindFirstChildOfClass("ProximityPrompt")
                or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
            if prompt then pcall(fireproximityprompt, prompt) end
        end
    end
    Notify("强制 TP 完成")
end

