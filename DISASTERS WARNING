-- ==================== Functions ====================
local function Notify(msg)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "灾难警告之VIP版本",
            Text = tostring(msg),
            Duration = 3
        })
    end)
end

local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isShelter(obj)
    local n = obj.Name:lower()
    for _, v in ipairs(ShelterNames) do
        if n:find(v:lower()) then return true end
    end
    return false
end

local function cleanCache(cache)
    for obj in pairs(cache) do
        if not obj or not obj.Parent then
            cache[obj] = nil
        end
    end
end

local function checkGameText()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end

    local foundDisaster = nil
    local foundNext = nil
    local foundDanger = false
    local foundEnd = false

    for _, g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox") then
            local t = (g.Text or ""):lower()

            if t:find("danger alert") or t:find("danger alerts") then
                foundDanger = true
            end

            if t:find("the end") or t:find("theend") then
                foundEnd = true
            end

            if t:find("tornado") then foundDisaster = "Tornado"
            elseif t:find("avalanche") then foundDisaster = "Avalanche"
            elseif t:find("meteor") then foundDisaster = "Meteor Shower"
            elseif t:find("tsunami") then foundDisaster = "Tsunami"
            elseif t:find("comet") then foundDisaster = "Comet Shower"
            elseif t:find("lethal smog") or t:find("smog") then foundDisaster = "Lethal Smog"
            elseif t:find("mothership") then foundDisaster = "Mothership"
            elseif t:find("volcano") or t:find("eruption") then foundDisaster = "Volcano"
            elseif t:find("blizzard") then foundDisaster = "Blizzard"
            elseif t:find("acid rain") then foundDisaster = "Acid Rain"
            elseif t:find("earthquake") then foundDisaster = "Earthquake"
            elseif t:find("flood") then foundDisaster = "Flood"
            elseif t:find("sandstorm") then foundDisaster = "Sandstorm"
            elseif t:find("thunderstorm") or t:find("lightning") then foundDisaster = "Thunderstorm"
            elseif t:find("wildfire") then foundDisaster = "Wildfire"
            elseif t:find("the end") then foundDisaster = "The End"
            end

            if t:find("next") or t:find("upcoming") or t:find("incoming") then
                if t:find("tornado") then foundNext = "Tornado"
                elseif t:find("avalanche") then foundNext = "Avalanche"
                elseif t:find("meteor") then foundNext = "Meteor Shower"
                elseif t:find("tsunami") then foundNext = "Tsunami"
                elseif t:find("the end") then foundNext = "The End"
                end
            end
        end
    end

    if foundDisaster then
        currentDisaster = foundDisaster
        lastDisasterTime = tick()
    elseif tick() - lastDisasterTime > 25 then
        currentDisaster = "Unknown"
    end

    if foundNext then
        nextDisaster = foundNext
    end

    if foundDanger and not lastDangerState then
        Notify("⚠ Danger Alerts 已开启！")
    end
    lastDangerState = foundDanger
    dangerAlerts = foundDanger
    theEndActive = foundEnd
end

local function goToShelter()
    local hrp = getHRP()
    if not hrp then return end
    cleanCache(knownShelters)

    for obj in pairs(knownShelters) do
        if obj and obj.Parent then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or part:FindFirstChildOfClass("ProximityPrompt")
                if prompt then pcall(fireproximityprompt, prompt) end
                Notify("Trying Shelter...")
                return
            end
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelter(obj) then
            knownShelters[obj] = true
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or part:FindFirstChildOfClass("ProximityPrompt")
                if prompt then pcall(fireproximityprompt, prompt) end
                Notify("Found Shelter")
                return
            end
        end
    end
end

local function forceTPShelter()
    local hrp = getHRP()
    if not hrp then
        Notify("没有角色")
        return
    end

    local candidates = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelter(obj) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                table.insert(candidates, part)
            end
        end
    end

    if #candidates == 0 then
        Notify("没找到避难所")
        return
    end

    local offsets = {
        Vector3.new(0, 4, 0),
        Vector3.new(0, 3, 6),
        Vector3.new(0, 3, -6),
        Vector3.new(6, 3, 0),
        Vector3.new(-6, 3, 0),
        Vector3.new(0, 6, 0),
        Vector3.new(0, 2, 10),
        Vector3.new(0, 2, -10),
    }

    Notify("强制 TP 进避难所...")
    for _, part in ipairs(candidates) do
        for _, offset in ipairs(offsets) do
            hrp.CFrame = part.CFrame + offset
            task.wait(0.07)
            local prompt = part:FindFirstChildOfClass("ProximityPrompt") or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
            if prompt then pcall(fireproximityprompt, prompt) end
        end
    end
    Notify("强制 TP 完成")
end

local function teleportToPlayer(player)
    local hrp = getHRP()
    if not hrp then return end
    local targetChar = player.Character
    if not targetChar then
        Notify(player.Name .. " 没有角色")
        return
    end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if targetHRP then
        hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 3, 0)
        Notify("已传送到 " .. player.Name)
    end
end

local function refreshPlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local y = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 26)
            btn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
            btn.Text = plr.Name
            btn.TextColor3 = Theme.TextWhite
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            btn.Parent = PlayerListFrame
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

            btn.MouseButton1Click:Connect(function()
                teleportToPlayer(plr)
            end)
            y = y + 30
        end
    end
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, y + 10)
end

