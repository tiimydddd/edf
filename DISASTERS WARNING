-- ==================== 工具函数 ====================
local function getHRP() local c = LocalPlayer.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = LocalPlayer.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function nameIn(obj, list) local n = (obj.Name or ""):lower() for _, v in ipairs(list) do if n:find(v:lower(), 1, true) then return true end end return false end
local function isShelterDoor(obj) return nameIn(obj, ShelterDoorNames) end
local function isChest(obj) return nameIn(obj, ChestNames) end
local function isCard(obj) if not nameIn(obj, CardNames) then return false end if nameIn(obj, StoreNames) then return false end return true end
local function isStore(obj) return nameIn(obj, StoreNames) end

local function bestPart(obj)
    if obj:IsA("BasePart") then 
        return obj 
    end
    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    if part then return part end
    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA("BasePart") then return p end
    end
    return obj:FindFirstChildWhichIsA("BasePart", false)
end

local function isDangerDisaster(name) if not name then return false end local n = tostring(name):lower() for _, d in ipairs(DangerDisasterList) do if n:find(d:lower(), 1, true) then return true end end return false end
local function isDustBowl(name) if not name then return false end local n = tostring(name):lower() for _, v in ipairs(DustBowlNames) do if n:find(v:lower(), 1, true) then return true end end return false end

local function isBlueMoonMall()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = (obj.Name or ""):lower()
        if n:find("blue moon mall") or n:find("bluemoonmall") or n:find("blue_moon_mall") then return true end
    end
    local values = Workspace:FindFirstChild("Values")
    if values then
        for _, v in ipairs(values:GetChildren()) do
            local n = (v.Name or ""):lower()
            local val = tostring(v.Value or ""):lower()
            if n:find("map") or n:find("place") or n:find("location") then
                if val:find("blue moon") or val:find("bluemoon") then return true end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do if isStore(obj) then return true end end
    return false
end

local function updateDisasterFromValues()
    local values = Workspace:FindFirstChild("Values")
    if not values then return end
    local cd = values:FindFirstChild("CurrentDisaster")
    if cd then currentDisaster = tostring(cd.Value or "") end
    local da = values:FindFirstChild("DangerAlert")
    if da then
        local val = da.Value
        if typeof(val) == "boolean" then dangerAlerts = val
        elseif typeof(val) == "number" then dangerAlerts = val ~= 0
        elseif typeof(val) == "string" then dangerAlerts = val:lower() == "true" or val:lower() == "on" or val == "1"
        else dangerAlerts = val and true or false
        end
    end
    theEndActive = tostring(currentDisaster):lower():find("the end") ~= nil
end

