-- ====================== 新增：车飞 & 碎石飞 ======================
local function isCar(obj)
    local n = (obj.Name or ""):lower()
    return n:find("car") or n:find("vehicle") or n:find("wheel")
end

local function isRock(obj)
    local n = (obj.Name or ""):lower()
    return n:find("rock") or n:find("stone") or n:find("碎石") or n:find("stonepiece")
end

local function explodeCar()
    local hrp = getHRP()
    if not hrp then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isCar(obj) then
            local part = bestPart(obj)
            if part then
                local ex = Instance.new("Explosion")
                ex.Position = part.Position
                ex.Parent = Workspace
                ex.BlastRadius = 15
                ex.BlastPressure = 100000

                part.AssemblyLinearVelocity = Vector3.new(math.random(-100,100), math.random(50,300), math.random(-100,100))
                part.AssemblyAngularVelocity = Vector3.new(math.random(-50,50), math.random(-50,50), math.random(-50,50))
                part.CanCollide = false
                break
            end
        end
    end
end

local function explodeRocks()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isRock(obj) then
            local part = bestPart(obj)
            if part then
                local ex = Instance.new("Explosion")
                ex.Position = part.Position
                ex.Parent = Workspace
                ex.BlastRadius = 25
                ex.BlastPressure = 80000

                part.AssemblyLinearVelocity = Vector3.new(math.random(-80,80), math.random(80,250), math.random(-80,80))
                part.AssemblyAngularVelocity = Vector3.new(math.random(-40,40), math.random(-40,40), math.random(-40,40))
                part.CanCollide = false
                break
            end
        end
    end
end

-- ====================== 按钮功能 ======================
local function makeBtn(parent, text, y, on)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -28, 0, 34)
    btn.Position = UDim2.new(0, 14, 0, y)
    btn.BackgroundColor3 = on and T.On or T.Off
    btn.Text = text
    btn.TextColor3 = T.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    return btn
end

