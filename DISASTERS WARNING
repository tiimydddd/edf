task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        local now = tick()

        checkGameText()

        StatusLabel.Text = "Status: " .. (Settings.AutoShelter and "Auto Shelter ON" or "Ready")
        StatusLabel.TextColor3 = Settings.AutoShelter and Color3.fromRGB(100, 200, 255) or Theme.TextGray

        DisasterLabel.Text = "当前灾难: " .. currentDisaster
        NextLabel.Text     = "下一场  : " .. nextDisaster
        DangerLabel.Text   = "Danger Alerts: " .. (dangerAlerts and "ON" or "Off")
        DangerLabel.TextColor3 = dangerAlerts and Color3.fromRGB(255, 120, 80) or Theme.TextGray
        EndLabel.Text = "The End: " .. (theEndActive and "YES" or "No")
