local function tryInteract(obj, hrp)
    local part = bestPart(obj)
    if not part then return false end

    local offsets = {
        Vector3.new(0, 3.2, 0),
        Vector3.new(0, 2.8, 2),
        Vector3.new(0, 2.8, -2),
        Vector3.new(2, 2.8, 0),
        Vector3.new(-2, 2.8, 0),
        Vector3.new(0, 4.5, 0),
    }

    local opened = false
    for _, offset in ipairs(offsets) do
        pcall(function() hrp.CFrame = CFrame.new(part.Position + offset) end)
        task.wait(0.1)

        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                for i = 1, 12 do
                    pcall(function() fireproximityprompt(d) end)
                    if i % 4 == 0 then task.wait(0.03) end
                end
                opened = true
            elseif d:IsA("ClickDetector") then
                for i = 1, 8 do pcall(function() fireclickdetector(d) end) end
                opened = true
            end
        end

        local ti = part:FindFirstChildOfClass("TouchInterest")
        if ti then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                task.wait(0.05)
                firetouchinterest(hrp, part, 1)
            end)
            opened = true
        end
        if opened then break end
    end
    return opened
end

-- 进避难所内部（优先内部物体）
local function goToShelter()
    local hrp = getHRP()
    if not hrp then return false end

    local insideCandidates = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelterInside(obj) then
            local part = bestPart(obj)
            if part then table.insert(insideCandidates, {obj = obj, part = part}) end
        end
    end

    if #insideCandidates > 0 then
        local best, bestDist = nil, math.huge
        for _, item in ipairs(insideCandidates) do
            local d = (item.part.Position - hrp.Position).Magnitude
            if d < bestDist then bestDist = d best = item end
        end
        if best then
            hrp.CFrame = best.part.CFrame + Vector3.new(0, 3, 0)
            tryInteract(best.obj, hrp)
            Notify("已进入避难所内部")
            return true
        end
    end

    -- 找不到内部就用门并往里偏移
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelterDoor(obj) then
            local part = bestPart(obj)
            if part then
                local insideOffset = part.CFrame.LookVector * -8 + Vector3.new(0, 3, 0)
                hrp.CFrame = part.CFrame + insideOffset
                Notify("已尝试进入避难所内部")
                return true
            end
        end
    end
    Notify("未找到避难所")
    return false
end

