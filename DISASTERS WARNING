local function checkDangerAlert()
    local found = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("danger") and (name:find("alert") or name:find("alerts")) then
            found = true
            break
        end
    end
    if found and not lastDangerState then Notify("⚠ Danger Alert 已开启！") end
    lastDangerState = found
    dangerAlerts = found
end

local function checkDisasterText()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    local foundDisaster, foundNext, foundEnd = nil, nil, false
    for _, g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox") then
            local t = (g.Text or ""):lower()
            if t:find("the end") then foundEnd = true end
            if t:find("wild card") or t:find("wildcard") then foundDisaster = "Wild Card"
            elseif t:find("tornado") then foundDisaster = "Tornado"
            elseif t:find("tsunami") then foundDisaster = "Tsunami"
            elseif t:find("meteor") then foundDisaster = "Meteor Shower"
            elseif t:find("volcano") then foundDisaster = "Volcano"
            elseif t:find("the end") then foundDisaster = "The End"
            end
            if t:find("next") or t:find("upcoming") then
                if t:find("wild card") then foundNext = "Wild Card"
                elseif t:find("tornado") then foundNext = "Tornado"
                elseif t:find("tsunami") then foundNext = "Tsunami"
                end
            end
        end
    end
    if foundDisaster then
        currentDisaster = foundDisaster
        lastDisasterTime = tick()
    elseif tick() - lastDisasterTime > 25 then
        currentDisaster = "Unknown"
    end
    if foundNext then nextDisaster = foundNext end
    theEndActive = foundEnd
end

