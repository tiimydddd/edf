local function applySpdJump()
    local h = getHum()
    if not h then return end
    pcall(function()
        if Settings.SpdOn then h.WalkSpeed = Settings.Spd else h.WalkSpeed = 16 end
        if Settings.JumpOn then
            if h.UseJumpPower then
                h.JumpPower = Settings.Jump
            else
                h.JumpHeight = math.clamp(Settings.Jump / 7.2, 7, 50)
            end
        else
            if h.UseJumpPower then h.JumpPower = 50 else h.JumpHeight = 7.2 end
        end
    end)
end

