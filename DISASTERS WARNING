local function isMallText(text)
    if not text then return false end
    local t = text:lower()
    for _, k in ipairs(MallKeywords) do
        if t:find(k:lower(), 1, true) then return true end
    end
    return false
end

local function autoVoteMall()
    if not Settings.AutoVoteMall then return end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end

    -- 寻找投票相关的按钮 / 文本
    for _, gui in ipairs(pg:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local text = (gui.Text or ""):lower()
            local name = (gui.Name or ""):lower()

            -- 检查按钮文字或名字是否包含商场关键词
            if isMallText(text) or isMallText(name) then
                -- 多点几次，尽量投满
                for i = 1, 8 do
                    pcall(function()
                        gui:Activate()
                    end)
                    pcall(function()
                        firesignal(gui.MouseButton1Click)
                    end)
                    pcall(function()
                        gui.MouseButton1Click:Fire()
                    end)
                    task.wait(0.05)
                end
            end
        elseif gui:IsA("TextLabel") or gui:IsA("TextButton") then
            -- 有些投票是点旁边的按钮，这里再辅助扫一次
            if isMallText(gui.Text) then
                local parent = gui.Parent
                if parent then
                    for _, child in ipairs(parent:GetChildren()) do
                        if child:IsA("TextButton") or child:IsA("ImageButton") then
                            for i = 1, 5 do
                                pcall(function() child:Activate() end)
                                pcall(function() firesignal(child.MouseButton1Click) end)
                                task.wait(0.04)
                            end
                        end
                    end
                end
            end
        end
    end
end
