-- 主循环
task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        local now = tick()
        checkDangerAlert()
        checkDisasterText()

        local statusText = "Ready"
        if Settings.AutoFarm then statusText = "★ Auto Farm ON"
        elseif Settings.AutoShelter then statusText = "秒开箱→避难所 ON"
        elseif Settings.AutoFarmCard then statusText = "Farm Card ON"
        end
        StatusLabel.Text = "  Status: " .. statusText
        StatusLabel.TextColor3 = (Settings.AutoFarm or Settings.AutoShelter or Settings.AutoFarmCard) and Color3.fromRGB(160, 100, 255) or T.Text

        DisasterLabel.Text = "当前灾难: " .. currentDisaster
        NextLabel.Text = "下一场: " .. nextDisaster
        DangerLabel.Text = "Danger Alerts: " .. (dangerAlerts and "ON" or "Off")
        DangerLabel.TextColor3 = dangerAlerts and Color3.fromRGB(255, 120, 80) or T.Sub
        EndLabel.Text = "The End: " .. (theEndActive and "YES" or "No")
        EndLabel.TextColor3 = theEndActive and Color3.fromRGB(255, 80, 80) or T.Sub

        local cc, kc = 0, 0
        for o in pairs(knownChests) do if o and o.Parent then cc = cc + 1 end end
        for o in pairs(knownCards) do if o and o.Parent then kc = kc + 1 end end
        ChestCountLabel.Text = "宝箱: " .. cc
        CardCountLabel.Text = "卡牌: " .. kc
        if gotCard or kc > 0 then
            CardStatusLabel.Text = "  Wild Card: " .. (gotCard and "已交互/已找到" or "地图有卡")
            CardStatusLabel.TextColor3 = Color3.fromRGB(180, 120, 255)
        else
            CardStatusLabel.Text = "  Wild Card: 未找到"
            CardStatusLabel.TextColor3 = T.Sub
        end

        if Settings.AutoFarm and (now - lastAutoFarm) >= AUTO_FARM_INTERVAL then
            lastAutoFarm = now
            autoFarmFlow()
        end
        if Settings.AutoShelter and (now - lastShelterCheck) >= SHELTER_INTERVAL then
            lastShelterCheck = now
            autoShelterFlow()
        end
        if Settings.DangerAuto and (now - lastDangerAuto) >= DANGER_AUTO_CD then
            local danger = dangerAlerts or theEndActive or isDangerDisaster(currentDisaster) or isDangerDisaster(nextDisaster)
            if danger then
                lastDangerAuto = now
                Notify("危险 → 开箱+进所")
                autoShelterFlow()
            end
        end
        if Settings.AutoCard and (now - lastCardCheck) >= CARD_INTERVAL then
            lastCardCheck = now
            if pickupCards() then Notify("已尝试捡卡") end
        end
        if Settings.AutoFarmCard and (now - lastFarmCard) >= FARM_CARD_INTERVAL then
            lastFarmCard = now
            autoFarmCard()
        end

        -- 自动投票商场
        if Settings.AutoVoteMall and (now - lastVoteCheck) >= VOTE_INTERVAL then
            lastVoteCheck = now
            autoVoteMall()
        end

        if Settings.SpdOn or Settings.JumpOn then applySpdJump() end
        task.wait(0.35)
    end
end)

