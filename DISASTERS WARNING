local function checkDangerAlert()
    local found = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("danger") and (name:find("alert") or name:find("alerts")) then
            found = true
            break
        end
    end
    if found and not lastDangerState then Notify("⚠ Danger Alert 已开启！") end
    lastDangerState = found
    dangerAlerts = found
end

local function checkDisasterText()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    local foundDisaster, foundNext, foundEnd = nil, nil, false
    for _, g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox") then
            local t = (g.Text or ""):lower()
            if t:find("the end") or t:find("theend") then foundEnd = true end
            if t:find("wild card") or t:find("wildcard") then foundDisaster = "Wild Card"
            elseif t:find("tornado") then foundDisaster = "Tornado"
            elseif t:find("avalanche") then foundDisaster = "Avalanche"
            elseif t:find("meteor") then foundDisaster = "Meteor Shower"
            elseif t:find("tsunami") then foundDisaster = "Tsunami"
            elseif t:find("comet") then foundDisaster = "Comet Shower"
            elseif t:find("lethal smog") or t:find("smog") then foundDisaster = "Lethal Smog"
            elseif t:find("mothership") then foundDisaster = "Mothership"
            elseif t:find("volcano") or t:find("eruption") then foundDisaster = "Volcano"
            elseif t:find("blizzard") then foundDisaster = "Blizzard"
            elseif t:find("acid rain") then foundDisaster = "Acid Rain"
            elseif t:find("earthquake") then foundDisaster = "Earthquake"
            elseif t:find("flood") then foundDisaster = "Flood"
            elseif t:find("sandstorm") then foundDisaster = "Sandstorm"
            elseif t:find("thunderstorm") or t:find("lightning") then foundDisaster = "Thunderstorm"
            elseif t:find("wildfire") then foundDisaster = "Wildfire"
            elseif t:find("berserk") then foundDisaster = "Berserk"
            elseif t:find("solar flare") then foundDisaster = "Solar Flare"
            elseif t:find("dance of the dead") then foundDisaster = "Dance of the Dead"
            elseif t:find("the end") then foundDisaster = "The End"
            end
            if t:find("next") or t:find("upcoming") or t:find("incoming") then
                if t:find("wild card") or t:find("wildcard") then foundNext = "Wild Card"
                elseif t:find("tornado") then foundNext = "Tornado"
                elseif t:find("tsunami") then foundNext = "Tsunami"
                elseif t:find("the end") then foundNext = "The End"
                elseif t:find("meteor") then foundNext = "Meteor Shower"
                end
            end
        end
    end
    if foundDisaster then
        currentDisaster = foundDisaster
        lastDisasterTime = tick()
    elseif tick() - lastDisasterTime > 25 then
        currentDisaster = "Unknown"
    end
    if foundNext then nextDisaster = foundNext end
    theEndActive = foundEnd
end

-- ESP
local chestEspFolder = Instance.new("Folder")
chestEspFolder.Name = "ChestESP"
chestEspFolder.Parent = ScreenGui
local cardEspFolder = Instance.new("Folder")
cardEspFolder.Name = "CardESP"
cardEspFolder.Parent = ScreenGui

local function clearFolder(f)
    for _, c in ipairs(f:GetChildren()) do c:Destroy() end
end

local function addESP(folder, obj, col, lab)
    local part = bestPart(obj)
    if not part then return end
    pcall(function()
        local hl = Instance.new("Highlight")
        hl.Adornee = obj:IsA("Model") and obj or part
        hl.FillColor = col
        hl.OutlineColor = col
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0.2
        hl.Parent = folder
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 70, 0, 18)
        bb.AlwaysOnTop = true
        bb.StudsOffset = Vector3.new(0, 2.2, 0)
        bb.Adornee = part
        bb.Parent = folder
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.Text = lab
        tl.TextColor3 = col
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 11
        tl.TextStrokeTransparency = 0.4
        tl.Parent = bb
    end)
end

local function refreshChestESP()
    clearFolder(chestEspFolder)
    if not Settings.ChestESP then return end
    cleanCache(knownChests)
    local count = 0
    for obj in pairs(knownChests) do
        if obj and obj.Parent then
            addESP(chestEspFolder, obj, Color3.fromRGB(255, 200, 60), "Chest")
            count = count + 1
        end
    end
    if count == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isChest(obj) then
                knownChests[obj] = true
                addESP(chestEspFolder, obj, Color3.fromRGB(255, 200, 60), "Chest")
            end
        end
    end
end

local function refreshCardESP()
    clearFolder(cardEspFolder)
    if not Settings.CardESP then return end
    cleanCache(knownCards)
    local count = 0
    for obj in pairs(knownCards) do
        if obj and obj.Parent then
            addESP(cardEspFolder, obj, Color3.fromRGB(180, 80, 255), "Card")
            count = count + 1
        end
    end
    if count == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isCard(obj) then
                knownCards[obj] = true
                addESP(cardEspFolder, obj, Color3.fromRGB(180, 80, 255), "Card")
