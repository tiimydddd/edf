local function queueDisaster(displayName, remoteName)
    local ok = false
    local vip = ReplicatedStorage:FindFirstChild("VIPServer")
    local disastersFolder = vip and vip:FindFirstChild("Disasters")
    if disastersFolder then
        local remote = disastersFolder:FindFirstChild(remoteName)
        if remote then
            local success = pcall(function() remote:FireServer() end)
            if success then ok = true end
        end
    end
    pcall(function()
        local msg = ReplicatedStorage:FindFirstChild("DisasterMessage2")
        if msg then msg:Fire("Classic") end
    end)
    pcall(function()
        local classic = ReplicatedStorage.VIPServer.GameStyle.Classic
        if classic then classic:FireServer() end
    end)
    if ok then Notify("已排队: " .. displayName) else Notify("排队失败（非VIP服或无此Remote）") end
    return ok
end

