-- 真实方块操控
local function getUnanchoredParts(range)
    local hrp = getHRP()
    if not hrp then return {} end
    local list = {}
    local myPos = hrp.Position
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and obj.CanCollide then
            local isCharacterPart = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character and obj:IsDescendantOf(plr.Character) then
                    isCharacterPart = true
                    break
                end
            end
            if not isCharacterPart then
                if (obj.Position - myPos).Magnitude <= (range or 120) then
                    table.insert(list, obj)
                end
            end
        end
    end
    return list
end

local blackHoleConn = nil
local function stopBlackHole()
    if blackHoleConn then blackHoleConn:Disconnect() blackHoleConn = nil end
    Settings.BlackHole = false
end
local function startBlackHole()
    stopBlackHole()
    blackHoleConn = RunService.Heartbeat:Connect(function()
        if not Settings.BlackHole then return end
        local hrp = getHRP()
        if not hrp then return end
        for _, part in ipairs(getUnanchoredParts(90)) do
            if part and part.Parent and not part.Anchored then
                pcall(function()
                    part:SetNetworkOwner(LocalPlayer)
                    local direction = (hrp.Position - part.Position).Unit
                    part.AssemblyLinearVelocity = part.AssemblyLinearVelocity:Lerp(direction * 85 + Vector3.new(0, 15, 0), 0.18)
                end)
            end
        end
    end)
end

