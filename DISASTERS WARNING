local function pickupCards()
    local hrp = getHRP()
    if not hrp then return false end
    cleanCache(knownCards)
    local got = false
    for obj in pairs(knownCards) do
        if obj and obj.Parent and tryInteract(obj, hrp) then
            got = true
            gotCard = true
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCard(obj) then
            knownCards[obj] = true
            if tryInteract(obj, hrp) then
                got = true
                gotCard = true
            end
        end
    end
    return got
end

local function tpNearestCard()
    local hrp = getHRP()
    if not hrp then Notify("没有角色") return end
    cleanCache(knownCards)
    local best, bestDist = nil, math.huge
    local function consider(obj)
        local part = bestPart(obj)
        if not part then return end
        local d = (part.Position - hrp.Position).Magnitude
        if d < bestDist then bestDist = d best = obj end
    end
    for obj in pairs(knownCards) do
        if obj and obj.Parent then consider(obj) end
    end
    if not best then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isCard(obj) then knownCards[obj] = true consider(obj) end
        end
    end
    if best then
        tryInteract(best, hrp)
        gotCard = true
        Notify(string.format("最近卡牌 (%.0f)", bestDist))
    else
        Notify("没有找到卡牌")
    end
end

local function tpCardStore()
    local hrp = getHRP()
    if not hrp then Notify("没有角色") return end
    cleanCache(knownStores)
    for obj in pairs(knownStores) do
        if obj and obj.Parent then
            local part = bestPart(obj)
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                Notify("已到 Cursed Card Store")
                return
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isStore(obj) then
            knownStores[obj] = true
            local part = bestPart(obj)
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                Notify("找到 Card Store")
                return
            end
        end
    end
    -- 模糊：名字带 cursed + card / store
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = (obj.Name or ""):lower()
        if (n:find("cursed") and n:find("card")) or (n:find("card") and n:find("store")) then
            local part = bestPart(obj)
            if part then
                knownStores[obj] = true
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                Notify("找到疑似卡牌店")
                return
            end
        end
    end
    Notify("未找到 Card Store")
end

