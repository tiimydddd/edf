local function tryInteract(obj, hrp)
    local part = bestPart(obj)
    if not part then return false end
    hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    local opened = false
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
        or part:FindFirstChildOfClass("ProximityPrompt")
        or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        for i = 1, 10 do pcall(fireproximityprompt, prompt) end
        opened = true
    end
    local click = obj:FindFirstChildOfClass("ClickDetector") or part:FindFirstChildOfClass("ClickDetector")
    if click then
        for i = 1, 8 do pcall(fireclickdetector, click) end
        opened = true
    end
    local ti = part:FindFirstChildOfClass("TouchInterest")
    if ti then
        pcall(function()
            firetouchinterest(hrp, part, 0)
            task.wait(0.02)
            firetouchinterest(hrp, part, 1)
        end)
        opened = true
    end
    return opened
end

local function openChests()
    local hrp = getHRP()
    if not hrp then return false end
    cleanCache(knownChests)
    local opened = false
    for obj in pairs(knownChests) do
        if obj and obj.Parent and tryInteract(obj, hrp) then opened = true end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isChest(obj) then
            knownChests[obj] = true
            if tryInteract(obj, hrp) then opened = true end
        end
    end
    return opened
end

local function goToShelter()
    local hrp = getHRP()
    if not hrp then return end
    cleanCache(knownShelters)
    for obj in pairs(knownShelters) do
        if obj and obj.Parent then
            local part = bestPart(obj)
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                tryInteract(obj, hrp)
                Notify("已到达避难所附近")
                return
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelter(obj) then
            knownShelters[obj] = true
            local part = bestPart(obj)
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                tryInteract(obj, hrp)
                Notify("找到避难所")
                return
            end
        end
    end
end

