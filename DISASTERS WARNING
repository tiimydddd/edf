-- ==================== 好玩功能：自动飞碎片 + 烟花 ====================
local FlyEnabled = false
local FlyConnection = nil
local FlyRange = 100
local FlyForce = 35

local function makePartsFly()
    local hrp = getHRP()
    if not hrp then return end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not obj.Anchored and not obj:IsDescendantOf(LocalPlayer.Character) then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < FlyRange then
                local old = obj:FindFirstChild("FlyForce")
                if old then old:Destroy() end

                local bv = Instance.new("BodyVelocity")
                bv.Name = "FlyForce"
                bv.MaxForce = Vector3.new(0, math.huge, 0)
                bv.Velocity = Vector3.new(0, FlyForce, 0)
                bv.Parent = obj

                task.delay(2, function()
                    if bv and bv.Parent then bv:Destroy() end
                end)
            end
        end
    end
end

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        FlyEnabled = not FlyEnabled
        if FlyEnabled then
            Notify("碎片和烟花自动飞起 已开启")
            FlyConnection = RunService.Heartbeat:Connect(makePartsFly)
        else
            Notify("碎片和烟花自动飞起 已关闭")
            if FlyConnection then
                FlyConnection:Disconnect()
                FlyConnection = nil
            end
        end
    end
end)

