local function nameIn(obj, list)
    local n = (obj.Name or ""):lower()
    for _, v in ipairs(list) do
        if n:find(v:lower(), 1, true) then return true end
    end
    return false
end

local function isShelter(obj) return nameIn(obj, ShelterNames) end
local function isChest(obj) return nameIn(obj, ChestNames) end
local function isCard(obj)
    if not nameIn(obj, CardNames) then return false end
    if nameIn(obj, StoreNames) then return false end
    return true
end
local function isStore(obj) return nameIn(obj, StoreNames) end

local function cleanCache(cache)
    for obj in pairs(cache) do
        if not obj or not obj.Parent then cache[obj] = nil end
    end
end

local function isDangerDisaster(name)
    if not name then return false end
    local n = name:lower()
    for _, d in ipairs(DangerDisasterList) do
        if n:find(d:lower(), 1, true) then return true end
    end
    return false
end

local function bestPart(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

-- ========== 加强版交互（解决开箱/找卡问题） ==========
local function tryInteract(obj, hrp)
    local part = bestPart(obj)
    if not part then return false end

    local offsets = {
        Vector3.new(0, 3.2, 0),
        Vector3.new(0, 2.8, 2),
        Vector3.new(0, 2.8, -2),
        Vector3.new(2, 2.8, 0),
        Vector3.new(-2, 2.8, 0),
        Vector3.new(0, 4.5, 0),
        Vector3.new(1.5, 3, 1.5),
        Vector3.new(-1.5, 3, -1.5),
    }

    local opened = false

    for _, offset in ipairs(offsets) do
        pcall(function()
            hrp.CFrame = CFrame.new(part.Position + offset)
        end)
        task.wait(0.12)

        -- ProximityPrompt 多方式尝试
        local prompts = {}
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
        end
        if part:IsA("BasePart") then
            for _, d in ipairs(part:GetChildren()) do
                if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
            end
        end

        for _, prompt in ipairs(prompts) do
            for i = 1, 15 do
                pcall(function()
                    fireproximityprompt(prompt)
                end)
                if i % 4 == 0 then task.wait(0.04) end
            end
            opened = true
        end

        -- ClickDetector
        local clicks = {}
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ClickDetector") then table.insert(clicks, d) end
        end
        for _, click in ipairs(clicks) do
            for i = 1, 10 do
                pcall(function() fireclickdetector(click) end)
            end
            opened = true
        end

        -- TouchInterest
        local ti = part:FindFirstChildOfClass("TouchInterest")
        if ti then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                task.wait(0.06)
                firetouchinterest(hrp, part, 1)
            end)
            opened = true
        end

        if opened then
            task.wait(0.15)
            break
        end
    end

    return opened
end
