local function updateDisasterFromValues()
    local values = Workspace:FindFirstChild("Values")
    if not values then return end
    local cd = values:FindFirstChild("CurrentDisaster")
    if cd then
        local v = cd.Value
        if typeof(v) == "string" and v ~= "" then
            currentDisaster = v
        elseif v ~= nil then
            currentDisaster = tostring(v)
        end
    end
    local da = values:FindFirstChild("DangerAlert")
    if da then
        local val = da.Value
        if typeof(val) == "boolean" then
            dangerAlerts = val
        elseif typeof(val) == "number" then
            dangerAlerts = val ~= 0
        elseif typeof(val) == "string" then
            local s = val:lower()
            dangerAlerts = (s == "true" or s == "on" or s == "1" or s == "yes")
        else
            dangerAlerts = val and true or false
        end
    end
    theEndActive = tostring(currentDisaster):lower():find("the end") ~= nil
end

