local function addESP(folder, obj, col, lab)
    local part = bestPart(obj)
    if not part then return end
    pcall(function()
        local hl = Instance.new("Highlight")
        hl.Adornee = obj:IsA("Model") and obj or part
        hl.FillColor = col
        hl.OutlineColor = col
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0.2
        hl.Parent = folder
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 70, 0, 18)
        bb.AlwaysOnTop = true
        bb.StudsOffset = Vector3.new(0, 2.2, 0)
        bb.Adornee = part
        bb.Parent = folder
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.Text = lab
        tl.TextColor3 = col
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 11
        tl.TextStrokeTransparency = 0.4
        tl.Parent = bb
    end)
end

local function refreshChestESP()
    clearFolder(chestEspFolder)
    if not Settings.ChestESP then return end
    cleanCache(knownChests)
    local count = 0
    for obj in pairs(knownChests) do
        if obj and obj.Parent then
            addESP(chestEspFolder, obj, Color3.fromRGB(255, 200, 60), "Chest")
            count = count + 1
        end
    end
    if count == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isChest(obj) then
                knownChests[obj] = true
                addESP(chestEspFolder, obj, Color3.fromRGB(255, 200, 60), "Chest")
                count = count + 1
            end
        end
    end
end

