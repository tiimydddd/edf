    if not hrp then
        Notify("没有角色")
        return
    end
    updateDisasterFromValues()
    if isDustBowl(currentDisaster) then
        getKey()
        task.wait(0.3)
        dustBowlFlow()
        return
    end
    Notify("1. 拿钥匙...")
    getKey()
    task.wait(0.35)
    if isBlueMoonMall() then
        Notify("2. Blue Moon Mall → 检查卡牌...")
        tryGetCard()
        task.wait(0.3)
    else
        Notify("2. 非商场，跳过找卡")
    end
    Notify("3. 传送到门并开门...")
    goToShelterDoorOnly()
end

