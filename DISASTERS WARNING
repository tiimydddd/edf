local function openChests()
    local hrp = getHRP()
    if not hrp then return false end
    cleanCache(knownChests)
    local opened = false

    -- 先处理已缓存的
    for obj in pairs(knownChests) do
        if obj and obj.Parent then
            if tryInteract(obj, hrp) then opened = true end
            task.wait(0.08)
        end
    end

    -- 再全图扫一次
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isChest(obj) then
            knownChests[obj] = true
            if tryInteract(obj, hrp) then opened = true end
            task.wait(0.06)
        end
    end
    return opened
end

local function goToShelter()
    local hrp = getHRP()
    if not hrp then return false end
    cleanCache(knownShelters)

    for obj in pairs(knownShelters) do
        if obj and obj.Parent then
            local part = bestPart(obj)
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                tryInteract(obj, hrp)
                return true
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isShelter(obj) then
            knownShelters[obj] = true
            local part = bestPart(obj)
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                tryInteract(obj, hrp)
                return true
            end
        end
    end
    return false
end

local function tpShelter()
    if goToShelter() then
        Notify("已传送到避难所")
    else
        Notify("未找到避难所")
    end
end

local function autoShelterFlow()
    Notify("秒开宝箱中...")
    openChests()
    task.wait(0.45)
    Notify("前往避难所...")
    goToShelter()
end

local function findCardStore()
    cleanCache(knownStores)
    for obj in pairs(knownStores) do
        if obj and obj.Parent then
            local part = bestPart(obj)
            if part then return obj, part end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isStore(obj) then
            knownStores[obj] = true
            local part = bestPart(obj)
            if part then return obj, part end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = (obj.Name or ""):lower()
        if (n:find("cursed") and n:find("card")) or (n:find("card") and n:find("store")) then
            local part = bestPart(obj)
            if part then
                knownStores[obj] = true
                return obj, part
            end
        end
    end
    return nil, nil
end

local function clickCardInStore()
    local hrp = getHRP()
    if not hrp then return false end

    local store, storePart = findCardStore()
    if storePart then
        hrp.CFrame = storePart.CFrame + Vector3.new(0, 4, 0)
        task.wait(0.25)
    end

    cleanCache(knownCards)
    local got = false

    -- 优先处理已缓存卡
    for obj in pairs(knownCards) do
        if obj and obj.Parent then
            if tryInteract(obj, hrp) then
                got = true
                gotCard = true
            end
        end
    end

    -- 全图再扫一次卡
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCard(obj) then
            knownCards[obj] = true
            if tryInteract(obj, hrp) then
                got = true
                gotCard = true
            end
            task.wait(0.05)
        end
    end
    return got
end

local function autoFarmFlow()
    Notify("★ Auto Farm 启动...")
    openChests()
    task.wait(0.5)

    -- 去商店点卡（加强版）
    local store, part = findCardStore()
    if part then
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = part.CFrame + Vector3.new(0, 4, 0)
            task.wait(0.3)
            clickCardInStore()
        end
    else
        -- 没找到商店也尝试直接点卡
        clickCardInStore()
    end

    task.wait(0.4)
    goToShelter()
    Notify("Auto Farm 一轮完成")
end

