local function tryInteract(obj, hrp)
    local part = bestPart(obj)
    if not part then return false end
    local offsets = {Vector3.new(0,3,0), Vector3.new(0,2.5,2), Vector3.new(0,2.5,-2), Vector3.new(2,2.5,0), Vector3.new(-2,2.5,0)}
    local opened = false
    for _, offset in ipairs(offsets) do
        pcall(function() hrp.CFrame = CFrame.new(part.Position + offset) end)
        task.wait(0.1)
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                for i = 1, 12 do pcall(function() fireproximityprompt(d) end) end opened = true
            elseif d:IsA("ClickDetector") then
                for i = 1, 8 do pcall(function() fireclickdetector(d) end) end opened = true
            end
        end
        local ti = part:FindFirstChildOfClass("TouchInterest")
        if ti then
            pcall(function()
                firetouchinterest(hrp, part, 0) task.wait(0.05)
                firetouchinterest(hrp, part, 1)
            end)
            opened = true
        end
        if opened then break end
    end
    return opened
end

local function findShelterDoor() for _, obj in ipairs(workspace:GetDescendants()) do if isShelterDoor(obj) then local part = bestPart(obj) return obj, part end end return nil, nil end
local function findFlares() for _, obj in ipairs(workspace:GetDescendants()) do local n = (obj.Name or ""):lower() for _, k in ipairs(FlareKeywords) do if n:find(k, 1, true) then local part = bestPart(obj) return obj, part end end end return nil, nil end

local function tryGetCard()
    local hrp = getHRP()
    if not hrp then return false end
    local storePart = nil
    for _, obj in ipairs(workspace:GetDescendants()) do if isStore(obj) then storePart = bestPart(obj) if storePart then break end end end
    if storePart then hrp.CFrame = storePart.CFrame + Vector3.new(0,4,0) task.wait(0.25) end
    local got = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCard(obj) then
            if tryInteract(obj, hrp) then got = true gotCard = true end
        end
    end
    return got
end

local function goToShelterDoorOnly()
    local hrp = getHRP()
    if not hrp then return false end
    local doorObj, doorPart = findShelterDoor()
    if doorPart then
        hrp.CFrame = doorPart.CFrame + Vector3.new(0,3,0)
        task.wait(0.2)
        if doorObj then tryInteract(doorObj, hrp) end
        local insideOffset = doorPart.CFrame.LookVector * -5 + Vector3.new(0,2,0)
        hrp.CFrame = doorPart.CFrame + insideOffset
        Notify("已到避难所门")
        return true
    end
    Notify("未找到避难所门")
    return false
end

